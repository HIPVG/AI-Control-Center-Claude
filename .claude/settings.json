{
  "permissions": {
    "allow": ["Read", "Grep", "Glob"],
    "deny": [
      "Read(./.env)", "Read(./secrets/**)",
      "Edit(./.claude/**)", "Write(./.claude/**)",
      "Edit(./.acc/**)", "Write(./.acc/**)",
      "Edit(./tests/acceptance/**)", "Write(./tests/acceptance/**)",
      "Edit(./docs/WORKING_RULES.md)", "Write(./docs/WORKING_RULES.md)",
      "Bash(git push:*)", "Bash(git reset:*)", "Bash(git clean:*)", "Bash(git stash:*)",
      "Bash(git checkout:*)", "Bash(git restore:*)", "Bash(rm:*)", "Bash(del:*)",
      "Bash(icacls:*)", "Bash(pip install:*)", "Bash(curl:*)", "Bash(python tools/acc.py:*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "python .claude/hooks/acc_guard.py" }]
      }
    ]
  }
}
