{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkOrder",
  "type": "object",
  "required": ["task_id", "goal", "task_type", "allowed_files", "acceptance_tests"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["code_fix", "config", "data", "plan"]},
    "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "max_retry": {"type": "integer", "minimum": 0},
    "requires_implementation": {"type": "boolean"}
  }
}
